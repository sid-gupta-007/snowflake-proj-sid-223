# ==============================================================================
# Snowflake Power Retail Analytics Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Snowflake account details.
# NEVER commit your real .env file or private keys to version control.

# Snowflake Account Identifier
# Example: xy12345.us-east-1 or orgname-accountname
SNOWFLAKE_ACCOUNT=your_org-your_account

# Snowflake User & Role
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Snowflake Warehouse, Database & Schema
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_DB
SNOWFLAKE_SCHEMA=RAW

# Authentication Type: 'KEYPAIR' (recommended for production/CI) or 'PASSWORD'
SNOWFLAKE_AUTH_TYPE=PASSWORD

# Option A: Password Authentication
SNOWFLAKE_PASSWORD=your_password_here

# Option B: Key-Pair Authentication (Recommended)
# Path to your unencrypted or encrypted RSA private key (.p8 or .pem)
SNOWFLAKE_PRIVATE_KEY_PATH=
# Passphrase for private key (leave blank if key is unencrypted)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional: Snowflake Client Session Parameters
SNOWFLAKE_CLIENT_SESSION_KEEP_ALIVE=FALSE
SNOWFLAKE_QUERY_TIMEOUT=300
